<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ad-hoc / unsigned builds: Sparkle is signed with a different Team ID.
     Hardened Runtime library validation blocks that unless disabled.
     With Developer ID, re-sign embedded frameworks to the same team and drop this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
